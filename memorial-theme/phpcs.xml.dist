<?xml version="1.0"?>
<ruleset name="Memorial Theme">
	<description>WordPress Coding Standards for the Memorial block theme. Enabled in CI from stage 2, when functions.php and patterns are rewritten; classic templates are removed in stage 2.</description>

	<file>functions.php</file>
	<file>inc</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="VariableAnalysis"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="memorial_theme"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="memorial-theme"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>
</ruleset>
