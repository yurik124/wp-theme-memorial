<?xml version="1.0"?>
<ruleset name="Memorial Plugin">
	<description>WordPress Coding Standards for Memorial Plugin. Covers all plugin code (tests have their own conventions and are checked by phpcs-compat.xml.dist).</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/tools/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Предупреждения показываются, но не валят проверку; ошибки — валят. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="VariableAnalysis"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="memorial_plugin"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="memorial-plugin"/>
			</property>
		</properties>
	</rule>
	<!-- Файлы называются по смыслу модуля (switchover.php), а не class-*.php: классов в них нет. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="false"/>
		</properties>
	</rule>
	<!-- Helpers that build HTML from already escaped parts (icons and laurels are static SVG from the plugin itself). -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="memorial_plugin_icon"/>
				<element value="memorial_plugin_laurel"/>
				<element value="memorial_plugin_noimg_mark"/>
				<element value="memorial_plugin_e"/>
				<element value="memorial_plugin_esc_t"/>
				<element value="memorial_plugin_chevron"/>
				<element value="memorial_plugin_sec_head"/>
				<element value="memorial_plugin_cat_tile_html"/>
				<element value="memorial_plugin_logo_html"/>
				<element value="memorial_plugin_review_rating_html"/>
				<element value="memorial_plugin_search_box"/>
				<element value="memorial_plugin_consent_text"/>
				<element value="memorial_plugin_services_grid"/>
				<element value="memorial_plugin_product_anchor"/>
				<element value="memorial_plugin_ratio_css"/>
			</property>
		</properties>
	</rule>
	<!-- Render templates of the legacy blocks are included inside memorial_plugin_legacy_render(): their variables are local to that function, not globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/blocks/legacy/render/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/blocks/legacy/render/*</exclude-pattern>
	</rule>
</ruleset>
