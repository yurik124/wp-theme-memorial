{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/works",
    "title": "Our works",
    "category": "memorial-services",
    "icon": "format-image",
    "description": "Completed works with photos, plot sizes and prices: gallery, cards or photos only.",
    "keywords": [
        "works",
        "portfolio",
        "photos",
        "mem_works",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "view": {
            "type": "string",
            "default": "gallery",
            "enum": [
                "gallery",
                "cards",
                "photos"
            ]
        },
        "type": {
            "type": "string",
            "default": ""
        },
        "works": {
            "type": "string",
            "default": ""
        },
        "count": {
            "type": "integer",
            "default": 0
        },
        "limit": {
            "type": "integer",
            "default": -1
        },
        "random": {
            "type": "boolean",
            "default": false
        },
        "size": {
            "type": "boolean",
            "default": true
        },
        "prices": {
            "type": "boolean",
            "default": true
        },
        "nav": {
            "type": "boolean",
            "default": true
        },
        "sort": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "interactivity": false
    },
    "example": {
        "attributes": {
            "view": "gallery",
            "type": "",
            "works": "",
            "count": 0,
            "limit": -1,
            "random": false,
            "size": true,
            "prices": true,
            "nav": true,
            "sort": true
        },
        "viewportWidth": 1000
    }
}
