{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/payment",
    "title": "Payment",
    "category": "memorial-catalog",
    "icon": "money-alt",
    "description": "Ways of payment and the instalment plan from Memorial → Prices → Payment — the same on every page.",
    "keywords": [
        "payment",
        "instalments",
        "card",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
