{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/services-grid",
    "title": "Services grid",
    "category": "memorial-services",
    "icon": "screenoptions",
    "description": "Service cards of the home page (Memorial → Services), full width.",
    "keywords": [
        "services",
        "grid",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": false
    },
    "example": {
        "attributes": {},
        "viewportWidth": 1000
    }
}
