{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/contacts-cards",
    "title": "Contact cards",
    "category": "memorial-contacts",
    "icon": "id-alt",
    "description": "“Call”, “Write” and the addresses with directions (Memorial → Contacts).",
    "keywords": [
        "contacts",
        "phone",
        "address",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "only": {
            "type": "string",
            "default": "all",
            "enum": [
                "all",
                "shop",
                "hall"
            ]
        },
        "landmarks": {
            "type": "boolean",
            "default": true
        },
        "route": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": true
    },
    "example": {
        "attributes": {
            "only": "all",
            "landmarks": true,
            "route": true
        },
        "viewportWidth": 1000
    }
}
