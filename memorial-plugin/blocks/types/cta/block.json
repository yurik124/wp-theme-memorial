{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/cta",
    "title": "Call to action",
    "category": "memorial-services",
    "icon": "megaphone",
    "description": "Heading, text and call / message buttons with the site phone.",
    "keywords": [
        "call to action",
        "phone",
        "mem_cta",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "title": {
            "type": "string",
            "default": ""
        },
        "text": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "interactivity": false
    },
    "example": {
        "attributes": {
            "title": "",
            "text": ""
        },
        "viewportWidth": 1000
    }
}
