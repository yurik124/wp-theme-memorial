{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/reviews",
    "title": "Reviews from review sites",
    "category": "memorial-reviews",
    "icon": "star-filled",
    "description": "Review widgets and links to review sites (Memorial → Reviews).",
    "keywords": [
        "reviews",
        "rating",
        "mem_reviews",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "interactivity": false
    },
    "example": {
        "attributes": {},
        "viewportWidth": 1000
    }
}
