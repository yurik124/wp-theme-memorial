{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/cremation",
    "title": "Cremation prices",
    "category": "memorial-catalog",
    "icon": "editor-table",
    "description": "Price table of a package with the total (Memorial → Prices → Funeral packages); by default — the cremation package.",
    "keywords": [
        "cremation",
        "prices",
        "mem_cremation",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "paket": {
            "type": "string",
            "default": ""
        },
        "left": {
            "type": "string",
            "default": ""
        },
        "right": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "interactivity": false
    },
    "example": {
        "attributes": {
            "paket": "",
            "left": "",
            "right": ""
        },
        "viewportWidth": 1000
    }
}
