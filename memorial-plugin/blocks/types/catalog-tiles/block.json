{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/catalog-tiles",
    "title": "Catalog section tiles",
    "category": "memorial-catalog",
    "icon": "screenoptions",
    "description": "Catalog sections as photo tiles (menu sub-items of the catalog page, or all sections).",
    "keywords": [
        "catalog",
        "tiles",
        "categories",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": true
    },
    "example": {
        "attributes": {},
        "viewportWidth": 1000
    }
}
