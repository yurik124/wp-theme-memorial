{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/callback-dialog",
    "title": "Call me back window",
    "category": "memorial-layout",
    "icon": "phone",
    "description": "Hidden window with the call back form; opens from “Call me back” buttons.",
    "keywords": [
        "call back",
        "form",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "reusable": false,
        "multiple": false
    },
    "example": {
        "attributes": {},
        "viewportWidth": 800
    }
}
