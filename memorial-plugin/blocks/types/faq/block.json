{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/faq",
    "title": "All questions and answers",
    "category": "memorial-services",
    "icon": "editor-help",
    "description": "Questions from all pages (Details blocks) on one page, with search.",
    "keywords": [
        "questions",
        "FAQ",
        "mem_faq",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "exclude": {
            "type": "string",
            "default": ""
        },
        "search": {
            "type": "boolean",
            "default": true
        },
        "popular": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "interactivity": false
    },
    "example": {
        "attributes": {
            "exclude": "",
            "search": true,
            "popular": ""
        },
        "viewportWidth": 1000
    }
}
