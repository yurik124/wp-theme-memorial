{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/vehicle",
    "title": "Funeral transport",
    "category": "memorial-services",
    "icon": "car",
    "description": "The hearse from Memorial → Transport: photos outside and inside, seats, features, the price of a trip and the call button; a line about the bus. Not for the page of the transportation of the deceased.",
    "keywords": [
        "hearse",
        "transport",
        "bus",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "vehicle": {
            "type": "integer",
            "default": 0
        },
        "price": {
            "type": "boolean",
            "default": true
        },
        "bus": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": true
    },
    "example": {
        "attributes": {
            "vehicle": 0,
            "price": true,
            "bus": true
        },
        "viewportWidth": 1000
    }
}
