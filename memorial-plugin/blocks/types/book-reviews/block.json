{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/book-reviews",
    "title": "Guest book reviews",
    "category": "memorial-reviews",
    "icon": "book",
    "description": "Reviews left on this site.",
    "keywords": [
        "reviews",
        "book",
        "mem_bookreviews",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "limit": {
            "type": "integer",
            "default": -1
        },
        "title": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "interactivity": false
    },
    "example": {
        "attributes": {
            "limit": -1,
            "title": ""
        },
        "viewportWidth": 1000
    }
}
