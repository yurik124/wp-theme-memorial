{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/review-widget",
    "title": "Yandex reviews widget",
    "category": "memorial-reviews",
    "icon": "star-filled",
    "description": "Official Yandex Maps reviews widget; loads after cookie consent or on a click.",
    "keywords": [
        "reviews",
        "Yandex",
        "widget",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": true
    },
    "example": {
        "attributes": {},
        "viewportWidth": 1000
    }
}
