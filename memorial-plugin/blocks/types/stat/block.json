{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/stat",
    "title": "Figure in a laurel wreath",
    "category": "memorial-design",
    "icon": "awards",
    "description": "Number with a caption in a laurel wreath; the number counts up when it scrolls into view.",
    "keywords": [
        "number",
        "figure",
        "wreath",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "number": {
            "type": "string",
            "default": ""
        },
        "label": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": true
    },
    "example": {
        "attributes": {
            "number": "",
            "label": ""
        },
        "viewportWidth": 400
    }
}
