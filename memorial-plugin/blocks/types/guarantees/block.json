{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "memorial-plugin/guarantees",
    "title": "Our guarantees",
    "category": "memorial-catalog",
    "icon": "shield",
    "description": "Guarantees from Memorial → Prices → Guarantees: cards with an icon, a heading and a text — the same on every page.",
    "keywords": [
        "guarantee",
        "contract",
        "trust",
        "memorial"
    ],
    "textdomain": "memorial-plugin",
    "attributes": {
        "set": {
            "type": "string",
            "default": "all",
            "enum": [
                "all",
                "funeral",
                "monuments"
            ]
        },
        "count": {
            "type": "integer",
            "default": 0
        },
        "heading": {
            "type": "boolean",
            "default": true
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "cols": {
            "type": "integer",
            "default": 3,
            "enum": [
                2,
                3
            ]
        }
    },
    "supports": {
        "autoRegister": true,
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "inserter": true
    },
    "example": {
        "attributes": {
            "set": "all",
            "count": 0,
            "heading": true,
            "title": "",
            "cols": 3
        },
        "viewportWidth": 1000
    }
}
