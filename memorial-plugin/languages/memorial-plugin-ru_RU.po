msgid "(this text is no longer in the settings)"
msgstr "(этого текста больше нет в настройках)"

msgid "A phone number has only digits, spaces, brackets, hyphens and a leading “+”."
msgstr "В номере телефона только цифры, пробелы, скобки, дефисы и «+» в начале."

msgid "Changed — it goes to the settings when you save the page."
msgstr "Изменено — попадёт в настройки, когда вы сохраните страницу."

msgid "Memorial settings"
msgstr "Настройки Мемориала"

msgid "Only a whole number without spaces."
msgstr "Только целое число без пробелов."

msgid "Only an editor or an administrator can change it."
msgstr "Изменить его может только редактор или администратор."

msgid "Shared text"
msgstr "Общий текст"

msgid "The shared texts were not saved."
msgstr "Общие тексты не сохранились."

msgid "The text is too long: up to %d characters."
msgstr "Текст слишком длинный: не больше %d знаков."

msgid "These settings were changed elsewhere while the page was open (in another tab or by another person). Reload the page to see the current texts, then make the change again."
msgstr "Эти настройки изменили в другом месте, пока страница была открыта (в другой вкладке или другой человек). Перезагрузите страницу, чтобы увидеть текущие тексты, и внесите правку ещё раз."

msgid "These settings were changed elsewhere while this screen was open (on a page of the site, in another tab or by another person). Reload the screen — your changes here are not saved."
msgstr "Эти настройки изменили в другом месте, пока экран был открыт (на странице сайта, в другой вкладке или другой человек). Перезагрузите экран — ваши изменения здесь не сохранены."

msgid "This is not an email address."
msgstr "Это не адрес электронной почты."

msgid "This text is stored once in the Memorial settings: a change here changes it on every page that shows it, after the page is saved."
msgstr "Этот текст хранится один раз в настройках «Мемориала»: правка здесь меняет его на всех страницах, где он выводится, — после сохранения страницы."

msgid "This text no longer exists in the settings (the row was removed?)."
msgstr "Этого текста больше нет в настройках (строку удалили?)."

msgid "Calls at night (shared text)"
msgstr "Звонки ночью (общий текст)"

msgid "The line “Calls outside working hours” from Memorial → Contacts. It can be changed right on the page — the change goes to the settings and to every page that shows it."
msgstr "Строка «Звонки в нерабочее время» из «Мемориал → Контакты». Её можно поменять прямо на странице — правка попадёт в настройки и на все страницы, где она выводится."

msgid "A heading and three lines from Memorial → Contacts. The lines can be edited right on the page — they change on every page and in the settings."
msgstr "Заголовок и три строки из «Мемориал → Контакты». Строки можно править прямо на странице — они меняются на всех страницах и в настройках."

msgid "A paragraph whose text is kept in Memorial → Contacts: edit it here or there — it changes everywhere."
msgstr "Абзац, текст которого хранится в «Мемориал → Контакты»: правьте здесь или там — он изменится везде."

msgid "Contacts: phone, address and hours (shared texts)"
msgstr "Контакты: телефон, адрес и часы (общие тексты)"

msgid "How to reach us"
msgstr "Как с нами связаться"

msgid "Main address (shared text)"
msgstr "Основной адрес (общий текст)"

msgid "Main address (the first one in Memorial → Contacts)"
msgstr "Основной адрес (первый в «Мемориал → Контакты»)"

msgid "Main phone (shared text)"
msgstr "Основной телефон (общий текст)"

msgid "Main phone (the first one in Memorial → Contacts)"
msgstr "Основной телефон (первый в «Мемориал → Контакты»)"

msgid "Not chosen — the block has its own text, only on this page."
msgstr "Не выбрано — у блока свой текст, только на этой странице."

msgid "Opening hours (shared text)"
msgstr "Часы работы (общий текст)"

msgid "Opening hours of the main address"
msgstr "Часы работы основного адреса"

msgid "Take the text from the Memorial settings"
msgstr "Взять текст из настроек «Мемориала»"

