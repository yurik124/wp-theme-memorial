msgstr "Фото %1$d из %2$d"

msgid "Open photo %d large"
msgstr "Открыть фото %d крупно"

msgid "Products have a line under the name"
msgstr "У товаров есть строка под названием"

msgid "For example “height 90 cm”: a field in the products table and in the product window, a line under the name on the site. When it is off, the lines already typed are kept, only not shown."
msgstr "Например, «высота 90 см»: поле в таблице товаров и в окне товара, строка под названием на сайте. Если выключить — уже введённые строки сохраняются, просто не показываются."

msgid "From 2 to 6; empty — 4."
msgstr "От 2 до 6; пусто — 4."

msgid "Columns on a phone"
msgstr "Колонок на телефоне"

msgid "One column — large photos, one product under another; two — more products on the screen."
msgstr "Одна колонка — крупные фото, товары друг под другом; две — больше товаров на экране."

msgid "Products on the site"
msgstr "Товары на сайте"

msgid "Actions for the selected items"
msgstr "Действия с выбранными"

msgid "This description had lists or photos: after a change it is saved as plain text."
msgstr "В этом описании были списки или фото: после изменения оно сохранится простым текстом."

msgid "An empty line starts a new paragraph."
msgstr "Пустая строка — новый абзац."
