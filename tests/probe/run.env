PROBE_GREP='условия и отзывы'
PROBE_PHASES='block'
PROBE_UPLOADS=1
PROBE_CLI='wp option update blog_public 1; echo "== terms_1:"; wp option get memorial_plugin_terms_1; wp eval "\$l = get_option(\"memorial_plugin_terms_1_log\"); echo json_encode(array(\"posts\" => array_keys((array) (\$l[\"posts\"] ?? array())), \"skipped\" => \$l[\"skipped\"] ?? null, \"faq_skipped\" => \$l[\"faq_skipped\"] ?? null, \"titles\" => \$l[\"titles\"] ?? null), JSON_UNESCAPED_UNICODE);"; echo; echo "== groby title:"; wp post meta get $(wp post list --post_type=page --name=groby --field=ID) _seopress_titles_title; echo "== faq:"; wp post get $(wp post list --post_type=page --name=vopros-otvet --field=ID) --field=post_content | grep -n "summary\|wp-block-heading" | head -60'
