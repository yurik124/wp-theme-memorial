PROBE_GREP='адреса и SEO'
PROBE_PHASES='block'
PROBE_UPLOADS=1
PROBE_CLI='wp option update blog_public 1; echo "== seo_1:"; wp option get memorial_plugin_seo_1; echo "== log:"; wp option get memorial_plugin_seo_1_log --format=json; echo "== cookie noindex:"; wp post meta get $(wp post list --post_type=page --name=politika-cookie --field=ID) _seopress_robots_index; echo "== registry:"; wp eval "echo implode(\",\", array_keys(memorial_plugin_seo_registry()));"; echo; wp eval "foreach (array_keys(memorial_plugin_seo_registry()) as \$k) echo \$k, \" = \", memorial_plugin_seo_value(\$k), PHP_EOL;"'
