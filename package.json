{
	"name": "memorial-site",
	"private": true,
	"description": "Memorial theme and plugin: build, lint and checks",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20.10"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js memorial-plugin/src memorial-plugin/assets/js/view memorial-theme/src tests/e2e tests/visual tools --no-error-on-unmatched-pattern",
		"lint:css": "wp-scripts lint-style \"memorial-plugin/src/**/*.{css,scss}\" \"memorial-theme/src/**/*.{css,scss}\" --allow-empty-input",
		"lint:json": "node tools/validate-json.mjs",
		"lint:php:prefixes": "php tools/check-prefixes.php",
		"test:smoke": "php tests/smoke/switch.php && php tests/smoke/metrika.php && php tests/smoke/settings.php && php tests/smoke/seo.php",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.js"
	},
	"devDependencies": {
		"@playwright/test": "latest",
		"@wordpress/admin-ui": "latest",
		"@wordpress/a11y": "latest",
		"@wordpress/api-fetch": "latest",
		"@wordpress/block-editor": "latest",
		"@wordpress/commands": "latest",
		"@wordpress/components": "latest",
		"@wordpress/core-data": "latest",
		"@wordpress/data": "latest",
		"@wordpress/dataviews": "latest",
		"@wordpress/dependency-extraction-webpack-plugin": "latest",
		"@wordpress/editor": "latest",
		"@wordpress/element": "latest",
		"@wordpress/env": "latest",
		"@wordpress/i18n": "latest",
		"@wordpress/icons": "latest",
		"@wordpress/interactivity": "latest",
		"@wordpress/media-utils": "latest",
		"@wordpress/plugins": "latest",
		"@wordpress/url": "latest",
		"@wordpress/rich-text": "latest",
		"@wordpress/scripts": "latest",
		"ajv": "^8.17.1"
	}
}
